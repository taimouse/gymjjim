# Edge Function 시크릿 예시 (로컬: 이 파일을 supabase/functions/.env 로 복사, 운영: `pnpm supabase secrets set --env-file ...`)

# Cron 이 부를 때 x-cron-secret 헤더로 보내는 값. Vault 의 gymjjim_cron_secret 과 같아야 한다
NOTIFY_CRON_SECRET=

# 알림톡 발송대행사: mock(기본, 보내지 않고 로그·기록만) | solapi
NOTIFY_ALIMTALK_PROVIDER=mock

# Solapi (NOTIFY_ALIMTALK_PROVIDER=solapi 일 때)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 사전 등록한 발신번호 (문자 대체발송에 필요)
SOLAPI_SENDER_NUMBER=
# 카카오 채널 연동 ID (pfId)
SOLAPI_KAKAO_PFID=
# 우리 템플릿 코드 → 카카오 검수를 받은 Solapi 템플릿 ID (JSON 한 줄)
SOLAPI_TEMPLATE_IDS={"BOOKING_CONFIRMED":"","WAITLIST_PROMOTED":"","SESSION_CHANGED":"","SESSION_CANCELLED":"","REMINDER_DAY_BEFORE":"","REMINDER_2H":"","PASS_EXPIRING_D7":"","PASS_REMAINING_ONE":"","MEMBER_INVITE":""}
