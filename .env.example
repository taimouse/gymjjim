# ─────────────────────────────────────────────────────────────
# gymjjim 환경 변수 예시. 복사해서 .env.local 로 쓰세요.
#   cp .env.example .env.local
# 로컬 Supabase 값은 `pnpm supabase status` 출력에서 복사합니다.
# ─────────────────────────────────────────────────────────────

# 앱 주소 (초대 링크·OAuth 콜백 생성에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용. 직원 초대 등 관리 작업에만 사용하며 절대 클라이언트에 노출하지 않는다.
SUPABASE_SECRET_KEY=

# 카카오 로그인 (supabase/config.toml 의 [auth.external.kakao] 에서 읽음)
SUPABASE_AUTH_EXTERNAL_KAKAO_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_KAKAO_SECRET=

# 알림톡 발송 설정(발송대행사 키·템플릿 ID)은 Edge Function 시크릿입니다 → supabase/functions/.env.example
# SMS 대체발송 여부는 관리자 설정 > 알림에서 센터별로 켭니다.

# 웹 푸시 (VAPID). `pnpm dlx web-push generate-vapid-keys` 로 생성
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
